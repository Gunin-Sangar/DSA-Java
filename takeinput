// FOR INT INPUT
Scanner sc = new Scanner(System.in);

// converts String to int
int n = Integer.parseInt(sc.nextLine());

for (int i = 0; i < n; i++) {
    String line = sc.nextLine();
    String[] parts = line.split("\\s+",2);

    int a = Integer.parseInt(parts[0]);
    int b = Integer.parseInt(parts[1]);
}







